name: Daily world deposits FX refresh
on:
  schedule:
    - cron: '30 13 * * *'   # 6:30 AM PT (PDT)
  workflow_dispatch:
permissions:
  contents: write
jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Fetch FX and rebuild world.html
        run: python3 scripts/build_yields.py --fetch
      - name: Commit if changed
        run: |
          git config user.name "money-bot"
          git config user.email "money-bot@users.noreply.github.com"
          git add data/fx.json docs/
          git diff --cached --quiet || git commit -m "Daily FX refresh for world deposits $(date -u +%F)"
          git push
      - name: Compose site
        run: sh scripts/site_dir.sh
      - uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy _site --project-name money --commit-dirty=true
